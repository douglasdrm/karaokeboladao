{
  "rules": {
    ".read": "auth != null && auth.token.email === 'douglasdrm@gmail.com'",
    ".write": "auth != null && auth.token.email === 'douglasdrm@gmail.com'",

    "config": {
      ".read": "true",
      ".write": "auth != null && auth.token.email === 'douglasdrm@gmail.com'"
    },

    "catalog_chunks": {
      ".read": "true",
      ".write": "auth != null && auth.token.email === 'douglasdrm@gmail.com'"
    },

    "feedback": {
      ".read": "auth != null && auth.token.email === 'douglasdrm@gmail.com'",
      ".write": "auth != null"
    },

    "salas": {
      ".read": "false",
      ".write": "false",
      "$room_id": {
        ".read": "auth != null",
        ".write": "auth != null && auth.token.email === 'douglasdrm@gmail.com'",
        "info": {
          ".read": "auth != null",
          ".write": "auth != null"
        },
        "active_users": {
          ".read": "auth != null",
          "$uid": {
            ".read": "auth != null",
            ".write": "auth != null && auth.uid === $uid"
          }
        },
        "pedidos": {
          ".read": "auth != null",
          ".write": "auth != null"
        },
        "queue_v13": {
          ".read": "auth != null",
          ".write": "auth != null"
        },
        "queue_sync": {
          ".read": "auth != null",
          ".write": "auth != null"
        },
        "now_playing": {
          ".read": "auth != null",
          ".write": "auth != null",
          "votes": {
            "$uid": {
              ".read": "auth != null",
              ".write": "auth != null && auth.uid === $uid"
            }
          }
        },
        "last_score": {
          ".read": "auth != null",
          ".write": "auth != null"
        },
        "reactions": {
          ".read": "auth != null",
          ".write": "auth != null",
          ".indexOn": ["timestamp"]
        }
      }
    },

    "users": {
      ".read": "auth != null && auth.token.email === 'douglasdrm@gmail.com'",
      ".write": "auth != null && auth.token.email === 'douglasdrm@gmail.com'",
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid"
      }
    }
  }
}