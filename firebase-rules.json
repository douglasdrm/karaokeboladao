{
  "rules": {
    "salas": {
      "$room_id": {
        ".read": "auth != null",
        "info": {
          ".write": "auth != null && (!data.exists() || data.child('hostId').val() === auth.uid)"
        },
        "pedidos": {
          ".write": "auth != null",
          "$pedido_id": {
            ".validate": "newData.hasChildren(['id', 'singer', 'timestamp'])"
          }
        },
        "active_users": {
          "$user_id": {
            ".write": "auth.uid === $user_id"
          }
        },

        "now_playing": {
          ".write": "auth != null",
          "votes": {
            "$user_id": {
              ".write": "auth != null && auth.uid === $user_id"
            }
          }
        },
        "queue_v13": {
          ".write": "auth != null"
        }
      }
    },
    "users": {
      ".read": "auth.token.email === 'douglasdrm@gmail.com'",
      "$user_id": {
        ".read": "auth.uid === $user_id || auth.token.email === 'douglasdrm@gmail.com'",
        ".write": "auth.uid === $user_id || auth.token.email === 'douglasdrm@gmail.com'",
        "subscription": {
          ".write": "auth.token.email === 'douglasdrm@gmail.com'"
        }
      }
    }
  }
}